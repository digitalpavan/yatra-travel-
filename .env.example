# =============================================================================
# Yatra Travel — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables starting with NEXT_PUBLIC_ are exposed to the browser — only put
# public values there. Everything else is server-only.
# =============================================================================

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key — SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Razorpay (Dashboard → Account & Settings → API Keys / Webhooks) --------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend — https://resend.com; verify your sending domain) --------
RESEND_API_KEY=
# e.g. "Yatra Travel <bookings@your-domain.in>"
EMAIL_FROM=
# Internal alerts (refunds needed, webhook problems)
STAFF_ALERT_EMAIL=

# --- WhatsApp Business Platform (Cloud API) — optional ----------------------
# Requires a Meta Business account, verified business, registered phone number
# and an APPROVED message template. Leave blank to disable automated messages.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name with 3 body variables: {{1}} name, {{2}} reference, {{3}} pickup time
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# --- Scheduled jobs ----------------------------------------------------------
# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as a bearer token.
CRON_SECRET=

# --- Privacy -----------------------------------------------------------------
# Random salt for hashing IP addresses in consent/rate-limit records.
IP_HASH_SALT=

# --- Analytics & Search Console (optional; enable only after configuring) ----
# GA4 loads only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
